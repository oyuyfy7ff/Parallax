<?xml version="1.0" encoding="utf-8"?>
<!-- Backup rules for Android 12+. The transcription API key must never leave the device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="librecuts_transcription.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="librecuts_transcription.xml"/>
    </device-transfer>
</data-extraction-rules>
