<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_bottom_nav_docked"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:elevation="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp">

            <ImageButton
                android:id="@+id/btnKeyframeCancel"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_close_24"
                android:padding="8dp"
                android:scaleType="fitCenter"
                app:tint="@color/activeTool" />

            <!-- Property Select Button (opens PopupMenu) -->
            <Button
                android:id="@+id/btnKeyframeProperty"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="8dp"
                android:text="Position"
                android:textColor="@color/textColor"
                android:fontFamily="sans-serif-medium"
                android:textSize="15sp"
                app:icon="@drawable/ic_arrow_drop_down_24"
                app:iconGravity="textEnd"
                app:iconTint="@color/textColor"/>

            <!-- Add/Remove Keyframe Button -->
            <ImageButton
                android:id="@+id/btnKeyframeAction"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_keyframe_add"
                android:padding="8dp"
                android:scaleType="fitCenter"
                app:tint="@color/activeTool" />

            <ImageButton
                android:id="@+id/btnKeyframeDone"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_check_24"
                android:padding="8dp"
                android:scaleType="fitCenter"
                app:tint="@color/activeTool" />
        </LinearLayout>

        <!-- Easing curve editor for the keyframe at the playhead (shown only on a keyframe) -->
        <LinearLayout
            android:id="@+id/layoutKeyframeEasing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp"
            android:visibility="gone">

            <com.tharunbirla.librecuts.customviews.KeyframeGraphView
                android:id="@+id/graphKeyframeEasing"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_marginHorizontal="16dp"
                android:contentDescription="Easing curve. Drag the two handles to shape it." />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:paddingHorizontal="12dp"
                android:clipToPadding="false">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipsKeyframeEasing"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleLine="true"
                    app:chipSpacingHorizontal="6dp">

                    <com.google.android.material.chip.Chip
                        style="@style/Widget.Material3.Chip.Assist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Linear"
                        android:tag="linear" />
                    <com.google.android.material.chip.Chip
                        style="@style/Widget.Material3.Chip.Assist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ease In"
                        android:tag="ease_in" />
                    <com.google.android.material.chip.Chip
                        style="@style/Widget.Material3.Chip.Assist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ease Out"
                        android:tag="ease_out" />
                    <com.google.android.material.chip.Chip
                        style="@style/Widget.Material3.Chip.Assist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ease In-Out"
                        android:tag="ease_in_out" />
                    <com.google.android.material.chip.Chip
                        style="@style/Widget.Material3.Chip.Assist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Smooth"
                        android:tag="bezier:0.250,0.100,0.250,1.000" />
                    <com.google.android.material.chip.Chip
                        style="@style/Widget.Material3.Chip.Assist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Snappy"
                        android:tag="bezier:0.200,0.000,0.000,1.000" />
                    <com.google.android.material.chip.Chip
                        style="@style/Widget.Material3.Chip.Assist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Back"
                        android:tag="bezier:0.340,1.560,0.640,1.000" />
                    <com.google.android.material.chip.Chip
                        style="@style/Widget.Material3.Chip.Assist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Anticipate"
                        android:tag="bezier:0.360,-0.560,0.660,1.000" />
                    <com.google.android.material.chip.Chip
                        style="@style/Widget.Material3.Chip.Assist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hold"
                        android:tag="hold" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>
        </LinearLayout>

        <!-- Value Slider Row (hidden by default, shown for Opacity/Speed) -->
        <LinearLayout
            android:id="@+id/layoutKeyframeSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:layout_marginTop="8dp"
            android:visibility="gone">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp">

                <TextView
                    android:id="@+id/tvSliderLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Opacity"
                    android:textColor="@color/textColor"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvSliderValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="100%"
                    android:textColor="@color/activeTool"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium" />
            </RelativeLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderKeyframeValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="0.0"
                android:valueTo="100.0"
                android:value="100.0"
                app:haloColor="@color/activeTool"
                app:thumbColor="@color/activeTool"
                app:trackColorActive="@color/activeTool" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
